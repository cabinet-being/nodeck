MYSQL_DATABASE=nodeck
MYSQL_USER=nodeck
# Both passwords are required; the stack refuses to start while they are empty or "change-me".
# Generate each one with:  tr -dc A-Za-z0-9 </dev/urandom | head -c 24
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

BACKEND_HTTP_PORT=5080

# MySQL is published on 127.0.0.1 by default; change the host port if 3306 is taken.
# MYSQL_BIND_ADDRESS=0.0.0.0 exposes MySQL to the whole LAN (for desktop DB tools) and
# requires strong passwords above.
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_HOST_PORT=3306

# Set by the release bundle; leave unset for development builds (tag "dev").
# NODECK_VERSION=0.1.0
# TZ=UTC
